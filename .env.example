# انسخ الملف ده باسم .env وعدّل اللي محتاجه (كله اختياري)
# فولدر البيانات (قاعدة البيانات، التشغيلات، الكاش)
# SD_DATA_DIR=C:\student_distributor_data
# قاعدة الأماكن (OSM + GeoNames) لو مش في data\gazetteer.sqlite
# GAZETTEER_DB=C:\Users\HP\locations\data\gazetteer.sqlite
# سيرفر OSRM
# OSRM_URL=http://127.0.0.1:5001
# العنوان والبورت (0.0.0.0 لو عايز تفتحه على الشبكة المحلية)
# SD_HOST=127.0.0.1
# SD_PORT=5000
# مفتاح Google Geocoding (أو حطه في data\google_key.txt)
# GOOGLE_API_KEY=
